# ─── 데이터 경로 ─────────────────────────────────────────────────────────────
# 1분봉(min1) parquet·종목코드 캐시가 들어있는 상위 폴더.
# 미지정 시 저장소 내부 analysis/data 를 사용(기본). 데이터를 공유 드라이브 등
# 저장소 밖에 둘 때만 지정한다. 예) MIRAE_DATA_ROOT=G:/내 드라이브/mirae_data
# (해당 폴더 아래 min1/ 와 .cache/ 가 있어야 함)
MIRAE_DATA_ROOT=

# ─── Claude (Anthropic) API — LLM 자연어 생성 ────────────────────────────────
# 키 발급: https://console.anthropic.com  (형식: sk-ant-...)
ANTHROPIC_API_KEY=
# 검증/오프라인 강제 차단: 1|true 면 키가 있어도 모든 LLM 생성을 fallback(룰/템플릿)
# 으로 떨어뜨려 토큰을 쓰지 않는다. 실서비스에선 비워둔다.
MIRAE_DISABLE_LLM=
# 모델 (용도별). 품질용 sonnet/opus, 대량 알림용 haiku.
LLM_MODEL=claude-sonnet-4-6          # 리포트·거래별 원인 설명 (품질)
ALERT_LLM_MODEL=claude-haiku-4-5-20251001   # 실시간 알림 (저렴·빠름)
PSYCH_LLM_MODEL=claude-sonnet-4-6    # 심리 진단 문장화 (psych_agent)

# ─── Supabase (Next.js 클라이언트용) ─────────────────────────────────────────
# 프로젝트 URL — Supabase 대시보드 > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# 익명(anon) 키 — RLS 적용, 브라우저에 노출 가능
# Supabase 대시보드 > Settings > API > Project API Keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서비스 롤 키 — RLS 우회, 서버(API Route / Server Action)에서만 사용
# 절대 클라이언트 코드나 NEXT_PUBLIC_ 접두어로 노출하지 말 것
# Supabase 대시보드 > Settings > API > Project API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase (Python 분석 환경용) ───────────────────────────────────────────
# Python 노트북에서 Supabase 데이터를 불러올 때 사용
# 위 NEXT_PUBLIC_SUPABASE_URL 과 동일한 값 입력
SUPABASE_URL=

# 분석용 키 — 읽기 전용이면 anon key, 전체 접근이 필요하면 service_role key
# 분석 환경은 로컬에서만 실행되므로 service_role 사용도 가능하나 유출 주의
SUPABASE_KEY=

# ─── 키움 REST API (1분봉 수집용) ────────────────────────────────────────────
# 키움 개발자센터 > 앱 등록 후 발급받은 앱키/시크릿키
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 실전: https://api.kiwoom.com  /  모의: https://mockapi.kiwoom.com (KRX만 지원)
KIWOOM_BASE_URL=https://api.kiwoom.com

# 안전 수집 파라미터 (선택 — 미지정 시 기본값 사용)
KIWOOM_SLEEP=0.35          # 요청 간 최소 대기(초). 차단 시 0.5~1.0 으로 상향
KIWOOM_MAX_RETRIES=4       # 실패 시 재시도 횟수
KIWOOM_RETRY_BACKOFF=2.0   # 재시도 백오프 배수

# Runtime DB backend for Python analysis.
# sqlite keeps the current local behavior. supabase validates SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY before production storage adapters are wired in.
MIRAE_DB_BACKEND=sqlite
MIRAE_ORCHESTRATOR_DB=analysis/data/orchestrator.sqlite3
MIRAE_PROFILE_DB=analysis/data/user_profiles.sqlite3
